# Shopify Storefront API — see DEPLOYMENT.md for how to obtain these.

# Your shop's *.myshopify.com domain (not your custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token from your Headless / custom app in Shopify admin.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version. Check https://shopify.dev/docs/api/usage/versioning
# for the current release and bump this quarterly.
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Resend (email API) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# ─── Meta Pixel / Conversions API ────────────────────────────────────────────

# Pixel ID from Events Manager. Public by design (it ships in the page).
# Leave blank to disable all tracking — useful for local dev and previews.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token: Events Manager → your dataset → Settings →
# Conversions API → Generate access token. SERVER ONLY — never prefix NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Graph API version used for CAPI calls.
META_API_VERSION=v21.0

# Set ONLY while verifying in Events Manager → Test Events, then remove.
# Events sent with a test code are excluded from optimisation.
META_TEST_EVENT_CODE=

# Shared secret for the Shopify orders/create webhook signature check.
# Shopify admin → Settings → Notifications → Webhooks → the signing secret.
SHOPIFY_WEBHOOK_SECRET=
